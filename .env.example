# ============================================================
# CAMPUSCARE — environment variables (example file)
# Copy the values you need into your shell, IDE run configuration,
# GitHub Actions secrets, or hosting provider dashboard.
# NEVER commit a real .env file.
# ============================================================

# ---------- Backend / MySQL 8 ----------
DB_URL=jdbc:mysql://localhost:3306/helpdesk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-mysql-password

# Random secret of at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Comma-separated allowed frontend origins (CORS)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Where optional complaint attachments are stored on the server
UPLOAD_DIR=uploads

# ---------- First MAIN_ADMIN bootstrap ----------
# Used only when no account with this email exists. Remove after first start.
# (There is no public administrator registration — this is the only way the
# first Main Admin account is created.)
MAIN_ADMIN_EMAIL=mainadmin@example.com
MAIN_ADMIN_PASSWORD=replace-with-a-strong-password
MAIN_ADMIN_NAME=Main Administrator

# ---------- Local demo accounts (dev profile only) ----------
# Used only with: --spring.profiles.active=dev
# Creates student@campuscare.local, admin@campuscare.local and
# mainadmin@campuscare.local with this password. Never use in production.
DEMO_PASSWORD=

# ---------- Frontend (static site) ----------
# Edit frontend/js/config.js for local development, or inject
# window.CAMPUSCARE_API_URL before config.js in production, e.g.:
CAMPUSCARE_API_URL=https://your-deployed-java-backend.example.com/api
