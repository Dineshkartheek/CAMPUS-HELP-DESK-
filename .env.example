# ============================================================
# CAMPUSCARE environment variables (example file)
# Copy the values you need into your shell, IDE run configuration,
# GitHub Actions secrets, or hosting provider dashboard.
# NEVER commit a real .env file.
# ============================================================

# ---------- Backend / MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/helpdesk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campuscare_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_DDL_AUTO=update

# Generate a long random value, for example with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Comma-separated allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

# ---------- First MAIN_ADMIN bootstrap ----------
# Used only when no account with this email exists.
MAIN_ADMIN_EMAIL=mainadmin@example.com
MAIN_ADMIN_PASSWORD=replace-with-a-strong-password
MAIN_ADMIN_NAME=CampusCare Main Administrator

# ---------- Optional Gemini AI ----------
# Leave empty to disable AI. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# ---------- Local demo accounts (dev profile only) ----------
# Used only when running with: --spring.profiles.active=dev
# Creates student@campuscare.local, admin@campuscare.local and
# mainadmin@campuscare.local with this password. Remove for production.
DEMO_PASSWORD=

# ---------- Frontend (Vite) ----------
# Must use the VITE_ prefix to be readable by the browser app.
VITE_API_URL=http://localhost:8080
