# Copy of the important backend settings, shown as a reference.
# The real file used by the application is backend/src/main/resources/application.properties.
# All secrets are environment variables, never literal values.

spring.application.name=campuscare
server.port=${PORT:8080}

spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/helpdesk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=${DB_DDL_AUTO:update}
spring.jpa.open-in-view=false

app.jwt.secret=${JWT_SECRET:}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
app.cors.allowed-origins=${FRONTEND_ORIGIN:http://localhost:5173}

app.gemini.api-key=${GEMINI_API_KEY:}
app.gemini.model=${GEMINI_MODEL:gemini-2.5-flash}
app.gemini.enabled=${GEMINI_ENABLED:true}

app.main-admin.email=${MAIN_ADMIN_EMAIL:}
app.main-admin.password=${MAIN_ADMIN_PASSWORD:}
app.main-admin.name=${MAIN_ADMIN_NAME:CampusCare Main Administrator}
