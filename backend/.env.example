# Backend environment variables (example)
# Do not commit real credentials.

DB_URL=jdbc:mysql://localhost:3306/helpdesk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campuscare_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_DDL_AUTO=update

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

FRONTEND_ORIGIN=http://localhost:5173

MAIN_ADMIN_EMAIL=mainadmin@example.com
MAIN_ADMIN_PASSWORD=replace-with-a-strong-password
MAIN_ADMIN_NAME=CampusCare Main Administrator

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# Only for the dev profile demonstration
DEMO_PASSWORD=
