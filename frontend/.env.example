# Vite only exposes variables that start with VITE_.
# Local development:
VITE_API_URL=http://localhost:8080

# Production example (replace with your real deployed Java backend):
# VITE_API_URL=https://campuscare-api.onrender.com

# NOTE: CAMPUSCARE_BACKEND_URL is NOT readable by Vite in the browser.
# Use VITE_API_URL in all frontend environments.
